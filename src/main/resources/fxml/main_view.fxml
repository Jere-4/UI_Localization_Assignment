<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sample.controller.MainController"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Title -->
    <Label fx:id="titleLabel"
           style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <!-- Distance -->
    <HBox spacing="10">
        <Label fx:id="distanceLabel" prefWidth="220" />
        <TextField fx:id="distanceField" />
    </HBox>

    <!-- Consumption -->
    <HBox spacing="10">
        <Label fx:id="consumptionLabel" prefWidth="220" />
        <TextField fx:id="consumptionField" />
    </HBox>

    <!-- Price -->
    <HBox spacing="10">
        <Label fx:id="priceLabel" prefWidth="220" />
        <TextField fx:id="priceField" />
    </HBox>

    <!-- Calculate Button -->
    <Button fx:id="calculateButton"
            maxWidth="Infinity" />

    <!-- Result -->
    <Label fx:id="resultLabel"
           wrapText="true"
           style="-fx-font-size: 14px;" />

    <!-- Language Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="enButton" text="EN" />
        <Button fx:id="frButton" text="FR" />
        <Button fx:id="jpButton" text="JP" />
        <Button fx:id="irButton" text="IR" />
    </HBox>

</VBox>
